# =============================================================
#  snakethai-api — variáveis de ambiente
#  Nenhum destes arquivos vai para o Git:
#
#    .env.dev  desenvolvimento (scripts\dev.bat start). Supabase LOCAL
#              e ambiente Cloudinary de DEV — nunca os de produção.
#    .env      imagem de produção local (scripts\dev.bat prod).
#
#  Em produção, cadastre estas chaves no painel da Render.
# =============================================================

# ── Base ─────────────────────────────────────────────────────
# Porta do servidor. Em produção a Render injeta automaticamente.
PORT=3000

# development | test | production
NODE_ENV=development

# debug | info | warn | error
LOG_LEVEL=debug

# CORS: o app nativo dispensa; a web do aluno precisa.
# Produção: https://snake-web-eight.vercel.app — SEM barra no final (comparação exata).
# Vazio = nenhuma origem de navegador é liberada.
# Aceita múltiplas origens separadas por vírgula.
ALLOWED_ORIGIN=

# ── Supabase — identidade e autorização (RLS) ────────────────
# Usado para validar o token do chamador e repassá-lo ao PostgREST.
#   .env.dev: http://host.docker.internal:55321 e a chave anon LOCAL
#             (`npx supabase status` na pasta snake-thai). Rodando sem
#             Docker (npm run dev), use http://127.0.0.1:55321.
#   .env:     https://SEU-PROJETO.supabase.co
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=

# ── Segurança: segunda barreira de autorização ───────────────
# Define o que fazer quando a RLS libera um comprovante que NÃO é do chamador.
#
#   rls           (padrão) confia na RLS e registra ALERTA em nível `error`.
#                 Não quebra o administrador previsto na especificação, e
#                 avisa na hora caso uma política de RLS caia.
#   somente-dono  nega qualquer acesso que não seja do próprio dono, mesmo
#                 que a RLS tenha liberado. Postura mais dura — use quando
#                 não houver administrador visualizando comprovante alheio.
POLITICA_ACESSO_COMPROVANTE=rls

# ── Cloudinary — módulo: comprovantes ────────────────────────
# No .env.dev, as credenciais do ambiente de DESENVOLVIMENTO: com as de
# produção, um teste local grava e apaga arquivo de aluno de verdade.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OPCIONAL. Presente → a URL de visualização do comprovante expira em 10 min.
# Ausente → a URL não expira (comportamento atual; nada quebra sem ela).
# NÃO é self-service: recurso do plano Advanced+ da Cloudinary, e a chave é
# fornecida pelo suporte deles (support.cloudinary.com), não gerada no painel.
# Ver P-12 em docs/PENDENCIAS.md.
CLOUDINARY_AUTH_TOKEN_KEY=

# =============================================================
#  AUSENTES DE PROPÓSITO — não adicione sem necessidade real:
#
#  SUPABASE_JWT_SECRET      permitiria FORJAR tokens de qualquer
#                           usuário. O servidor é bloqueado na
#                           inicialização se esta variável existir.
#
#  SUPABASE_SERVICE_ROLE_KEY  ignora a RLS por completo. Só se um
#                           módulo específico exigir escrita fora
#                           da RLS — e então isolado nesse módulo,
#                           com uso mínimo, nunca como atalho geral.
# =============================================================
