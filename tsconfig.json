{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    /* Tipagem forte obrigatória — nada de `any` implícito. [#11] */
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,

    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    "noEmit": true,
    "sourceMap": true,
    "declaration": false,
    "removeComments": false
  },

  /*
   * Este arquivo serve ao editor e ao `npm run typecheck`: ele enxerga o
   * código E os testes, para que um teste quebrado por mudança de tipo
   * apareça antes do commit. `rootDir`/`outDir` moram só no tsconfig.build —
   * aqui eles rejeitariam `tests/` por estar fora de `src`.
   */
  "include": ["src/**/*.ts", "tests/**/*.ts", "*.config.ts"],
  "exclude": ["node_modules", "dist"]
}
