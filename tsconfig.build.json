{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /* O build é o único que emite: só ele define de onde lê e para onde escreve. */
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "tests", "**/*.test.ts", "**/*.spec.ts"]
}
